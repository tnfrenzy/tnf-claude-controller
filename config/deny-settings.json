      "Bash(git clean*)",
      "Bash(git checkout main*)",
      "Bash(git checkout master*)",
      "Bash(git switch main*)",
      "Bash(git switch master*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d main*)",
      "Bash(git worktree*)",
      "Bash(git remote*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git * --force*)",
      "Bash(git * -f *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(Remove-Item *-Recurse*)",
      "Bash(rmdir /s*)",
      "Bash(del /s*)",
      "Bash(npm publish*)",
      "Bash(npm install -g*)",
      "Bash(curl *)",
